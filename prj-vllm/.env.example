# Copy to .env and adjust. .env is git-ignored — never commit real values.
# This file contains PLACEHOLDERS ONLY.

# vLLM OpenAI-compatible server
VLLM_PORT=8000
VLLM_BASE_URL=http://localhost:8000/v1
# Must match --served-model-name passed to the server (short name, not a path)
VLLM_SERVED_MODEL_NAME=qwen-14b-awq

# Where the server loads weights from (see download_model.py)
MODEL_PATH=./models/qwen-14b-awq
# Hugging Face repo to download from
MODEL_REPO=Qwen/Qwen2.5-14B-Instruct-AWQ

# Server tuning (optional; start_vllm.sh reads these)
VLLM_MAX_MODEL_LEN=24000
VLLM_GPU_MEMORY_UTILIZATION=0.85

# Client request timeout, seconds
VLLM_TIMEOUT=60

# Optional: only if you start vLLM with --api-key <value>, put the SAME value
# here. Leave blank for an unauthenticated local server (the usual case).
VLLM_API_KEY=
